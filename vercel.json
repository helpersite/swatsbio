{
  "buildCommand": "node -e \"const fs=require('fs'),cp=require('child_process');const dir=fs.existsSync('frontend')?'frontend':'.';cp.execSync('npm run build',{cwd:dir,stdio:'inherit'})\"",
  "outputDirectory": "frontend/dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://swatsbio-production.up.railway.app/api/$1"
    },
    {
      "source": "/meta/(.*)",
      "destination": "https://swatsbio-production.up.railway.app/meta/$1"
    },
    {
      "source": "/raw-meta/(.*)",
      "destination": "https://swatsbio-production.up.railway.app/meta/$1"
    },
    {
      "source": "/:username",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "(?i).*(discordbot|twitterbot|facebookexternalhit|telegrambot|whatsapp|slackbot|linkedinbot|embedly|quora|rogerbot|showyoubot|outbrain|pinterest|bingpreview|vkshare|w3c_validator|curl|wget).*"
        }
      ],
      "destination": "https://swatsbio-production.up.railway.app/meta/:username"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
