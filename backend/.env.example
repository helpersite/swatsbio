# ==========================================
# Swats.bio Backend — Environment Variables
# Copy these EXACTLY into Railway Variables UI
# (no quotes, no angle brackets)
# ==========================================

# ── DATABASE ──────────────────────────────
# Railway adds this automatically when you add the PostgreSQL plugin
# Do NOT set this manually in Railway
DATABASE_URL=

# ── JWT SECRET ────────────────────────────
# Set this to a strong random value for production.
JWT_SECRET=

# ── ADMIN ACCOUNT ─────────────────────────
# Set these before first startup if you want a seeded admin account.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ── FRONTEND & CORS ───────────────────────
FRONTEND_URL=https://your-frontend-domain.com
CORS_ORIGINS=https://your-frontend-domain.com

# ── CLOUDINARY ────────────────────────────
# Set this to your real Cloudinary URL or leave empty to use local uploads.
CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>

# ── DISCORD OAUTH & BOT ───────────────────
DISCORD_CLIENT_ID=your_discord_client_id
DISCORD_CLIENT_SECRET=your_discord_client_secret
DISCORD_REDIRECT_URI=https://your-backend.up.railway.app/api/auth/discord/callback
DISCORD_BOT_TOKEN=your_discord_bot_token_here
DISCORD_GUILD_ID=your_discord_server_id_here

# ── SPOTIFY ───────────────────────────────
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=https://your-backend.up.railway.app/api/connect/spotify/callback

# ── STRIPE DONATIONS ─────────────────────
# Register /api/donations/stripe/webhook for checkout.session.completed events.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
DONATION_GOAL_USD=2500

# ── CRYPTO DONATIONS ─────────────────────
# Configure real mainnet addresses before enabling these currencies.
DONATION_BTC_ADDRESS=
DONATION_ETH_ADDRESS=
DONATION_LTC_ADDRESS=
